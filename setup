#!/bin/bash

# ============================================================
# OMEGA-V1 • ZERO-FAILURE CYBERNETIC BOOTLOADER
# ============================================================

# Colors
G='\033[0;32m'
R='\033[0;31m'
Y='\033[0;33m'
NC='\033[0m'

echo -e "${G}"
echo " ██████╗ ███╗   ███╗███████╗ ██████╗  █████╗ "
echo "██╔═══██╗████╗ ████║██╔════╝██╔════╝ ██╔══██╗"
echo "██║   ██║██╔████╔██║█████╗  ██║  ███╗███████║"
echo "██║   ██║██║╚██╔╝██║██╔══╝  ██║   ██║██╔══██║"
echo "╚██████╔╝██║ ╚═╝ ██║███████╗╚██████╔╝██║  ██║"
echo " ╚═════╝ ╚═╝     ╚═╝╚══════╝ ╚═════╝ ╚═╝  ╚═╝"
echo -e "          ZERO-FAILURE BOOT SEQUENCE${NC}\n"

# Determine if sudo is needed
if [ "$EUID" -ne 0 ]; then
    SUDO="sudo"
else
    SUDO=""
fi

# Function to locate commands even if not in PATH
find_cmd() {
    command -v "$1" || which "$1" 2>/dev/null || find /usr/local/bin /usr/bin /bin /usr/sbin /sbin -name "$1" -executable -print -quit 2>/dev/null
}

# 1. Ensure Node.js is present
NODE_PATH=$(find_cmd node)
if [ -z "$NODE_PATH" ]; then
    echo -e "${Y}⚠️  Node.js missing. Attempting emergency installation...${NC}"
    if command -v apt-get &> /dev/null; then
        $SUDO apt-get update -y && $SUDO apt-get install -y curl ca-certificates gnupg
        $SUDO mkdir -p /etc/apt/keyrings
        $SUDO rm -f /etc/apt/keyrings/nodesource.gpg
        curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | $SUDO gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
        echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | $SUDO tee /etc/apt/sources.list.d/nodesource.list
        $SUDO apt-get update -y && $SUDO apt-get install nodejs -y
        NODE_PATH=$(find_cmd node)
    else
        echo -e "${R}❌ FATAL: Cannot install Node.js automatically. Install it manually.${NC}"
        exit 1
    fi
fi
echo -e "✅ Node.js: ${G}$($NODE_PATH -v)${NC} at $NODE_PATH"

# 2. Ensure NPM is present
NPM_PATH=$(find_cmd npm)
if [ -z "$NPM_PATH" ]; then
    echo -e "${Y}⚠️  npm missing. Attempting emergency installation...${NC}"
    if command -v apt-get &> /dev/null; then
        $SUDO apt-get update -y && $SUDO apt-get install -y npm
        NPM_PATH=$(find_cmd npm)
    fi
    
    if [ -z "$NPM_PATH" ]; then
        # Last resort: Try corepack if Node.js version supports it
        if $NODE_PATH -e "process.exit(process.versions.node.split('.')[0] >= 16 ? 0 : 1)" 2>/dev/null; then
            echo -e "${Y}Attempting to enable corepack...${NC}"
            $SUDO corepack enable 2>/dev/null
            NPM_PATH=$(find_cmd npm)
        fi
    fi

    if [ -z "$NPM_PATH" ]; then
        echo -e "${R}❌ FATAL: npm is missing and could not be installed automatically.${NC}"
        echo -e "Please install npm manually: ${Y}sudo apt-get install npm${NC}"
        exit 1
    fi
fi
echo -e "✅ npm: ${G}$($NPM_PATH -v)${NC} at $NPM_PATH"

# 3. Ensure PNPM or Fallback
PNPM_PATH=$(find_cmd pnpm)
if [ -z "$PNPM_PATH" ]; then
    echo -e "${Y}⚠️  pnpm missing. Installing locally for setup...${NC}"
    $NPM_PATH install -g pnpm || $NPM_PATH install pnpm --no-save
    PNPM_PATH=$(find_cmd pnpm) || PNPM_PATH="./node_modules/.bin/pnpm"
fi

# 4. Launch Wizard with Triple Fallback
echo -e "\n🚀 ${G}Initializing Setup Wizard...${NC}\n"

# Change to script directory
cd "$(dirname "$0")"

SETUP_SUCCESS=false

# FALLBACK 1: Try pnpm directly
if [ -f "$PNPM_PATH" ] || command -v pnpm &> /dev/null; then
    echo "Attempting Fallback 1 (pnpm)..."
    if $PNPM_PATH --filter @workspace/wa-bridge run setup; then
        SETUP_SUCCESS=true
    fi
fi

# FALLBACK 2: Try npm
if [ "$SETUP_SUCCESS" != "true" ]; then
    echo "Attempting Fallback 2 (npm)..."
    if npm --prefix artifacts/wa-bridge run setup; then
        SETUP_SUCCESS=true
    fi
fi

# FALLBACK 3: Emergency direct execution with local tsx
if [ "$SETUP_SUCCESS" != "true" ]; then
    echo -e "${Y}⚠️  Standard runners failed. Attempting Fallback 3 (Local tsx)...${NC}"
    if [ -d "artifacts/wa-bridge" ]; then
        cd artifacts/wa-bridge
        # Install tsx locally if missing
        if [ ! -f "node_modules/.bin/tsx" ]; then
            echo "Installing tsx locally..."
            npm install tsx --no-save
        fi
        
        if [ -f "node_modules/.bin/tsx" ]; then
            ./node_modules/.bin/tsx src/setup/run.ts && SETUP_SUCCESS=true
        elif command -v npx &> /dev/null; then
            npx tsx src/setup/run.ts && SETUP_SUCCESS=true
        else
            echo -e "${R}❌ FATAL: Could not run setup wizard. No tsx or npx found.${NC}"
            exit 1
        fi
        cd ../..
    else
        echo -e "${R}❌ FATAL: Could not locate wa-bridge directory.${NC}"
        exit 1
    fi
fi

if [ "$SETUP_SUCCESS" = "true" ]; then
    echo -e "\n${G}✅ Setup Wizard completed successfully.${NC}"
    echo -e "🚀 ${G}Building and starting the bot...${NC}\n"
    
    # Ensure dependencies are installed and project is built
    if command -v pnpm &> /dev/null; then
        pnpm install
        echo -e "\n${G}Building wa-bridge...${NC}"
        pnpm --filter @workspace/wa-bridge run build
        echo -e "\n${G}Starting bot...${NC}"
        exec pnpm --filter @workspace/wa-bridge run start
    else
        npm install
        echo -e "\n${G}Building wa-bridge...${NC}"
        npm --prefix artifacts/wa-bridge run build
        echo -e "\n${G}Starting bot...${NC}"
        exec npm --prefix artifacts/wa-bridge start
    fi
else
    echo -e "${R}❌ Setup failed to complete.${NC}"
    exit 1
fi
