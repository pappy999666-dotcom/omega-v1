#!/bin/bash

# ============================================================
# OMEGA-V1 • UNIVERSAL CYBERNETIC INSTALLER
# ============================================================

set -e

# Colors
G='\033[0;32m'
R='\033[0;31m'
Y='\033[0;33m'
NC='\033[0m'

echo -e "${G}"
echo " ██████╗ ███╗   ███╗███████╗ ██████╗  █████╗ "
echo "██╔═══██╗████╗ ████║██╔════╝██╔════╝ ██╔══██╗"
echo "██║   ██║██╔████╔██║█████╗  ██║  ███╗███████║"
echo "██║   ██║██║╚██╔╝██║██╔══╝  ██║   ██║██╔══██║"
echo "╚██████╔╝██║ ╚═╝ ██║███████╗╚██████╔╝██║  ██║"
echo " ╚═════╝ ╚═╝     ╚═╝╚══════╝ ╚═════╝ ╚═╝  ╚═╝"
echo -e "          UNIVERSAL SYSTEM BOOTLOADER${NC}\n"

# Determine if sudo is needed
if [ "$EUID" -ne 0 ]; then
    SUDO="sudo"
else
    SUDO=""
fi

# 1. Check & Install Node.js
if ! command -v node &> /dev/null; then
    echo -e "${Y}⚠️  Node.js not detected. Attempting automatic installation...${NC}"
    
    if command -v apt-get &> /dev/null; then
        echo -e "📦 Installing Node.js via apt..."
        $SUDO apt-get update -y
        $SUDO apt-get install -y curl ca-certificates gnupg
        $SUDO mkdir -p /etc/apt/keyrings
        curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | $SUDO gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg --overwrite
        NODE_MAJOR=20
        echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" | $SUDO tee /etc/apt/sources.list.d/nodesource.list
        $SUDO apt-get update -y
        $SUDO apt-get install nodejs -y
    else
        echo -e "${R}❌ Error: Package manager not supported. Please install Node.js manually.${NC}"
        exit 1
    fi
fi
echo -e "✅ Node.js: ${G}$(node -v)${NC}"

# 2. Check & Install Git
if ! command -v git &> /dev/null; then
    echo -e "${Y}⚠️  Git not detected. Installing...${NC}"
    if command -v apt-get &> /dev/null; then
        $SUDO apt-get install -y git
    fi
fi
echo -e "✅ Git: ${G}$(git --version)${NC}"

# 3. Check & Install PNPM
if ! command -v pnpm &> /dev/null; then
    echo -e "${Y}⚠️  pnpm not detected. Installing globally...${NC}"
    if command -v npm &> /dev/null; then
        $SUDO npm install -g pnpm
    else
        echo -e "📦 Installing pnpm via standalone script..."
        curl -fsSL https://get.pnpm.io/install.sh | sh -
        export PNPM_HOME="$HOME/.local/share/pnpm"
        export PATH="$PNPM_HOME:$PATH"
    fi
fi
echo -e "✅ pnpm: ${G}$(pnpm -v || echo 'Installed')${NC}"

# 4. Final Environment Check
echo -e "\n🚀 ${G}System core verified. Launching Omega Setup Wizard...${NC}\n"

# Ensure we are in the root directory
cd "$(dirname "$0")"

# Execute Wizard
# Use full path for npx to avoid command not found if path isn't updated
if command -v pnpm &> /dev/null; then
    pnpm --filter @workspace/wa-bridge run setup
else
    npm exec --prefix artifacts/wa-bridge tsx src/setup/run.ts
fi
