#!/bin/bash

# ============================================================
# OMEGA-V1 • ZERO-FAILURE CYBERNETIC BOOTLOADER
# ============================================================

# Neon Green Color
G='\033[0;32m'
R='\033[0;31m'
Y='\033[0;33m'
NC='\033[0m'

echo -e "${G}"
echo " ██████╗ ███╗   ███╗███████╗ ██████╗  █████╗ "
echo "██╔═══██╗████╗ ████║██╔════╝██╔════╝ ██╔══██╗"
echo "██║   ██║██╔████╔██║█████╗  ██║  ███╗███████║"
echo "██║   ██║██║╚██╔╝██║██╔══╝  ██║   ██║██╔══██║"
echo "╚██████╔╝██║ ╚═╝ ██║███████╗╚██████╔╝██║  ██║"
echo " ╚═════╝ ╚═╝     ╚═╝╚══════╝ ╚═════╝ ╚═╝  ╚═╝"
echo -e "          ZERO-FAILURE BOOT SEQUENCE${NC}\n"

# Determine if sudo is needed
if [ "$EUID" -ne 0 ]; then
    SUDO="sudo"
else
    SUDO=""
fi

# Function to locate commands even if not in PATH
find_cmd() {
    command -v "$1" || which "$1" 2>/dev/null || find /usr/local/bin /usr/bin /bin /usr/sbin /sbin -name "$1" -executable -print -quit 2>/dev/null
}

# 1. Ensure Node.js is present
NODE_PATH=$(find_cmd node)
if [ -z "$NODE_PATH" ]; then
    echo -e "${Y}⚠️  Node.js missing. Attempting emergency installation...${NC}"
    if command -v apt-get &> /dev/null; then
        $SUDO apt-get update -y && $SUDO apt-get install -y curl ca-certificates gnupg
        $SUDO mkdir -p /etc/apt/keyrings
        $SUDO rm -f /etc/apt/keyrings/nodesource.gpg
        curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | $SUDO gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
        echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | $SUDO tee /etc/apt/sources.list.d/nodesource.list
        $SUDO apt-get update -y && $SUDO apt-get install nodejs -y
        NODE_PATH=$(find_cmd node)
    else
        echo -e "${R}❌ FATAL: Cannot install Node.js automatically. Install it manually.${NC}"
        exit 1
    fi
fi
echo -e "✅ Node.js: ${G}$($NODE_PATH -v)${NC} at $NODE_PATH"

# 2. Ensure PNPM or Fallback
PNPM_PATH=$(find_cmd pnpm)
if [ -z "$PNPM_PATH" ]; then
    echo -e "${Y}⚠️  pnpm missing. Installing globally...${NC}"
    NPM_PATH=$(find_cmd npm)
    if [ ! -z "$NPM_PATH" ]; then
        $SUDO $NPM_PATH install -g pnpm || echo "Global install failed, will use npx fallback"
        PNPM_PATH=$(find_cmd pnpm)
    fi
fi

# 3. Launch Wizard with Triple Fallback
echo -e "\n🚀 ${G}Initializing Setup Wizard...${NC}\n"

# Change to script directory
cd "$(dirname "$0")"

# FALLBACK 1: Try pnpm directly
if [ ! -z "$PNPM_PATH" ]; then
    echo "Attempting Fallback 1 (pnpm)..."
    if $PNPM_PATH --filter @workspace/wa-bridge run setup; then
        exit 0
    fi
fi

# FALLBACK 2: Try npx pnpm
NPM_PATH=$(find_cmd npm)
if [ ! -z "$NPM_PATH" ]; then
    echo "Attempting Fallback 2 (npx pnpm)..."
    if $NODE_PATH "$NPM_PATH" exec pnpm --filter @workspace/wa-bridge run setup; then
        exit 0
    fi
fi

# FALLBACK 3: Emergency direct execution
echo -e "${Y}⚠️  Standard runners failed. Attempting Fallback 3 (Direct Execution)...${NC}"
if [ -d "artifacts/wa-bridge" ]; then
    cd artifacts/wa-bridge
    # Try to use tsx if available, otherwise install it temporarily
    $NODE_PATH "$NPM_PATH" exec tsx src/setup/run.ts
else
    echo -e "${R}❌ FATAL: Could not locate wa-bridge directory.${NC}"
    exit 1
fi
