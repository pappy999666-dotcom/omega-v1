#!/bin/bash

# ============================================================
# OMEGA-V1 • ZERO-CONFIG PRODUCTION BOOTLOADER
# ============================================================

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${GREEN}"
echo " ██████╗ ███╗   ███╗███████╗ ██████╗  █████╗ "
echo "██╔═══██╗████╗ ████║██╔════╝██╔════╝ ██╔══██╗"
echo "██║   ██║██╔████╔██║█████╗  ██║  ███╗███████║"
echo "██║   ██║██║╚██╔╝██║██╔══╝  ██║   ██║██╔══██║"
echo "╚██████╔╝██║ ╚═╝ ██║███████╗╚██████╔╝██║  ██║"
echo " ╚═════╝ ╚═╝     ╚═╝╚══════╝ ╚═════╝ ╚═╝  ╚═╝"
echo -e "          ZERO-CONFIG BOOT SEQUENCE${NC}\n"

# Determine sudo
if [ "$EUID" -ne 0 ]; then SUDO="sudo"; else SUDO=""; fi

# Function to check command
check_cmd() { command -v "$1" >/dev/null 2>&1; }

# 1. Node.js Check
if ! check_cmd node; then
    echo -e "${YELLOW}⚠️ Node.js missing. Installing...${NC}"
    curl -fsSL https://deb.nodesource.com/setup_20.x | $SUDO bash -
    $SUDO apt-get install -y nodejs
fi
echo -e "${GREEN}✓ Node.js $(node -v)${NC}"

# 2. PNPM Check
if ! check_cmd pnpm; then
    echo -e "${YELLOW}⚠️ pnpm missing. Installing...${NC}"
    $SUDO npm install -g pnpm
fi
echo -e "${GREEN}✓ pnpm $(pnpm -v)${NC}"

# 3. Workspace Detection
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$APP_DIR"

# 4. Run Smart Setup
echo -e "\n🚀 ${GREEN}Initializing Intelligent Setup Wizard...${NC}\n"

# Install setup dependencies
pnpm install --silent

# Run the TypeScript setup wizard
# This handles: Dependency detection, installation, configuration, PM2, Nginx, and Startup
if pnpm --filter @workspace/wa-bridge run setup; then
    echo -e "\n${GREEN}✅ System fully operational.${NC}"
else
    echo -e "\n${RED}❌ Setup failed. Check the errors above.${NC}"
    exit 1
fi
